{
  "name": "@murchey/dsh-session-manager",
  "version": "0.1.1",
  "description": "基于 DeepSeek Harness 的会话存储管理插件：查看会话磁盘占用、永久删除会话，并清理侧边栏失效条目。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node test/core.test.mjs && node test/client.test.mjs && node test/host.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-manager",
    "storage",
    "delete",
    "cleanup",
    "privacy"
  ],
  "author": "Murchey",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murchey/dsh-session-manager.git"
  },
  "homepage": "https://github.com/Murchey/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/Murchey/dsh-session-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
